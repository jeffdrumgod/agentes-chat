  "ids": {
    "desktop": "${BRAND_DESKTOP_ID}",
    "mobile": "${BRAND_APP_ID}"
  },
  "mobile": {
    "slug": "proa"
  },
  "generate": {
    "all": [
      "node packages/ui/scripts/favicon.mjs",
      "node packages/ui/scripts/app-icons.mjs",
      "bun packages/engine/scripts/email-art.ts",
      "bun run docs:env"
    ],
    "desktop": [
      "bun apps/desktop/scripts/icons.ts",
      "bun apps/desktop/scripts/dmg-art.ts",
      "bun apps/desktop/scripts/installer-art.ts"
    ]
  },
  "afterGenerate": {
    "apps/web/public/email/mark.png": "assets/mark.png",
    "apps/web/public/apple-touch-icon.png": "assets/3d/apple-touch-icon.png",
    "apps/web/public/icon-512.png": "assets/3d/icon-512.png",
    "apps/web/public/app-icons/night.png": "assets/3d/preview.png",
    "apps/desktop/app-icon.png": "assets/3d/icon.png",
    "apps/desktop/app-icon-tile.png": "assets/3d/icon.png",
    "apps/desktop/src-tauri/icons/app/night.png": "assets/3d/icon-512.png",
    "apps/desktop/src-tauri/icons/app/night-tile.png": "assets/3d/icon-512.png",
    "apps/mobile/assets/app-icons/peekNight/ios.png": "assets/3d/icon.png",
    "apps/mobile/assets/app-icons/peekNight/ios-dark.png": "assets/3d/ios-dark.png",
    "apps/mobile/assets/app-icons/peekNight/ios-tinted.png": "assets/3d/ios-tinted.png",
    "apps/mobile/assets/app-icons/peekNight/android-foreground.png": "assets/3d/android-foreground.png",
    "apps/mobile/assets/app-icons/peekNight/android-background.png": "assets/3d/android-background.png",
    "apps/mobile/assets/app-icons/peekNight/android-monochrome.png": "assets/3d/android-monochrome.png",
    "apps/mobile/assets/app-icons/peekNight/preview.png": "assets/3d/preview.png",
    "apps/mobile/assets/app-icons/peekNight/preview-dark.png": "assets/3d/preview-dark.png"
  },
  "rightHand": {
    "name": "Timo",
    "handle": "timo",
    "nameStory": {
      "en": "The name comes from timoneiro, Portuguese for helmsman: the one at the helm who keeps the boat on course.",
      "pt-BR": "O nome vem de timoneiro, quem fica no leme e mantém o barco no rumo.",
      "es": "El nombre viene de timoneiro, timonel en portugués: quien lleva el timón y mantiene el rumbo del barco."
    }
  },
  "css": {
    "apps/web/src/fonts.css": "fonts/brand-font.css",
    "apps/desktop/src/fonts.css": "fonts/brand-font.css",
    "packages/ui/src/styles/components.css": "fonts/brand-logo.css",
    "apps/web/src/styles.css": "fonts/brand-root.css",
    "apps/desktop/src/styles.css": "fonts/brand-root.css"
  },
  "serverDefaults": {
    "SOURCE_URL": "https://github.com/${BRAND_REPO}",
    "PUSH_SENDER": "direct",
    "APNS_APP_IDS": "${BRAND_APP_ID}",
    "DESKTOP_RELEASES_REPO": "${BRAND_REPO}",
    "FEEDBACK_RELAY": false,
    "TELEMETRY": "off",
    "PROBLEM_REPORT_URL": "off"
  },
  "patches": [
    {
      "why": "first run: joining an existing workspace is the first place (no hosted cloud of our own)",
      "file": "apps/desktop/src/windows/FirstRun.tsx",
      "find": "onCloud(makeFirst ? \"/onboarding\" : \"/login\");",
      "replace": "onConnect();"
    },
    {
      "why": "first run: the first place's title",
      "file": "apps/desktop/src/windows/FirstRun.tsx",
      "find": "{p === \"cloud\" && makeFirst ? t(\"desktop.first.addCloud\") : t(`desktop.place.${p}`)}",
      "replace": "{p === \"cloud\" ? t(\"desktop.connect.title\") : t(`desktop.place.${p}`)}"
    },
    {
      "why": "first run: the first place's line",
      "file": "apps/desktop/src/windows/FirstRun.tsx",
      "find": "<span className=\"ac-optrow__desc\">{t(`desktop.place.${p}Text`)}</span>",
      "replace": "<span className=\"ac-optrow__desc\">{p === \"cloud\" ? t(\"desktop.connect.lead\") : t(`desktop.place.${p}Text`)}</span>"
    },
    {
      "why": "first run: the first place's drawing is the team's server",
      "file": "apps/desktop/src/windows/FirstRun.tsx",
      "find": "<PlaceScene place={shown} computer={host.platform} shape=\"tall\" />",
      "replace": "<PlaceScene place={shown === \"cloud\" ? \"box\" : shown} computer={host.platform} shape=\"tall\" />"
    },
    {
      "why": "first run: no hosted-cloud sign-up line",
      "file": "apps/desktop/src/windows/FirstRun.tsx",
      "find": "{adding && !makeFirst && (",
      "replace": "{false && adding && !makeFirst && ("
    },
    {
      "why": "first run: the join line is now the first place",
      "file": "apps/desktop/src/windows/FirstRun.tsx",
      "find": "        <span className=\"dk-help dk-choose__more\">\n          {t(\"desktop.place.haveOne\")}{\" \"}\n          <button type=\"button\" className=\"ac-link dk-link\" onClick={onConnect}>\n            {t(\"desktop.place.haveOneLink\")}\n          </button>\n        </span>\n",
      "replace": ""
    },
    {
      "why": "server address examples use the product's name",
      "files": [
        "apps/desktop/src/i18n/keys.*.ts",
        "apps/desktop/src/i18n/locales/*.json",
        "apps/mobile/src/i18n/keys.*.ts",
        "apps/mobile/src/i18n/locales/*.json"
      ],
      "pattern": "agentes\\.([A-Za-z0-9-]+)\\.ts\\.net",
      "replace": "proa.$1.ts.net"
    },
    {
      "why": "desktop downloads: Proa's releases are tagged proa/AA.M.N (the same tag as the apps), not desktop-v*",
      "file": "apps/server/src/routes/desktop.ts",
      "find": "export const DESKTOP_TAG_PREFIX = \"desktop-v\";",
      "replace": "export const DESKTOP_TAG_PREFIX = \"proa/\";"
    },
    {
      "why": "desktop downloads: the Mac build as the Proa desktop workflow names it (fixed name, for the README's latest link)",
      "file": "apps/server/src/routes/desktop.ts",
      "find": "export const dmgName = (version: string) => `agentes_${version}_universal.dmg`;",
      "replace": "export const dmgName = (_version: string) => \"Proa-macOS.dmg\";"
    },
    {
      "why": "desktop downloads: no updater bundle (the updater is off, local/updater-off)",
      "file": "apps/server/src/routes/desktop.ts",
      "find": "export const updaterName = (version: string) => `agentes_${version}_universal.app.tar.gz`;",
      "replace": "export const updaterName = (_version: string) => \"Proa-macOS.app.tar.gz\";"
    },
    {
      "why": "desktop downloads: the Windows installers as the Proa desktop workflow names them",
      "file": "apps/server/src/routes/desktop.ts",
      "find": "const installer = `agentes_${version}_${target === \"windows\" ? \"x64\" : \"arm64\"}-setup.exe`;",
      "replace": "const installer = `Proa-Windows-${target === \"windows\" ? \"x64\" : \"arm64\"}-setup.exe`;"
    },
    {
      "why": "desktop downloads: the Linux deb and AppImage as the Proa desktop workflow names them",
      "file": "apps/server/src/routes/desktop.ts",
      "find": "return { download: `agentes_${version}_${arch}.deb`, updater: `agentes_${version}_${arch}.AppImage` };",
      "replace": "return { download: `Proa-Linux-${arch}.deb`, updater: `Proa-Linux-${target === \"linux\" ? \"x64\" : \"arm64\"}.AppImage` };"
    },
    {
      "why": "desktop downloads: Proa's repository is public, so the token is optional (sent only when set)",
      "file": "apps/server/src/routes/desktop.ts",
      "find": "authorization: `Bearer ${options.token}`,",
      "replace": "...(options.token ? { authorization: `Bearer ${options.token}` } : {}),"
    },
    {
      "why": "desktop downloads: read without a token (public repository)",
      "file": "apps/server/src/routes/desktop.ts",
      "find": "if (!options.token) return null;",
      "replace": "if (!options.repo) return null;"
    },
    {
      "why": "desktop downloads: download without a token (public repository)",
      "file": "apps/server/src/routes/desktop.ts",
      "find": "if (!options.token || !SEMVER.test(version) || !FILE_NAME.test(file)) return null;",
      "replace": "if (!SEMVER.test(version) || !FILE_NAME.test(file)) return null;"
    },
    {
      "why": "phone apps: the Google Play button opens Proa's Android app, not upstream's",
      "file": "apps/web/src/lib/phone-apps.ts",
      "find": "const GOOGLE_PLAY = \"https://play.google.com/store/apps/details?id=chat.agentes.app\";",
      "replace": "const GOOGLE_PLAY = \"https://play.google.com/store/apps/details?id=${BRAND_APP_ID}\";"
    }
  ]
}
