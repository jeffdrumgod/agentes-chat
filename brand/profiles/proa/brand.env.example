# Copy to brand.env (ignored by git) or pass with brand/build.sh --env <file>. brand.json reads these as ${NAME}.
# GitHub repository that hosts the source and the releases (download links, About › Source code, desktop releases).
BRAND_REPO=owner/repo
# Phone app bundle id and Android package (also the APNs app id the server accepts). Tied to one store account.
BRAND_APP_ID=com.example.proa
# Desktop app bundle id.
BRAND_DESKTOP_ID=com.example.proa.desktop
